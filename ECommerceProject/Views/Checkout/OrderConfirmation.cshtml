@model ECommerceProject.Models.Entities.Order
@{
    ViewData["Title"] = "Order Confirmation";
    var orderItems = ViewBag.OrderItems as List<ECommerceProject.Models.Entities.OrderItem>;
    var payment = ViewBag.Payment as ECommerceProject.Models.Entities.Payment;
}

<div class="py-4">
    <div class="grid" style="max-width: 700px; margin: 0 auto;">
        <!-- Success Message -->
        <div class="text-center mb-5">
            <div style="width: 80px; height: 80px; margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; background: var(--success-muted); border-radius: 50%;">
                <i class="bi bi-check-lg" style="font-size: 2.5rem; color: var(--success);"></i>
            </div>
            <h2 style="margin-bottom: 0.5rem; color: var(--success);">Order Confirmed!</h2>
            <p class="text-muted">Thank you for your order. Check your email for details.</p>
        </div>

        <!-- Order Details -->
        <div class="card mb-4">
            <div class="card-body" style="padding: 1.5rem;">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <span class="text-muted" style="font-size: 0.8rem;">Order Number</span>
                        <h4 style="margin-bottom: 0;">#@Model.Id</h4>
                    </div>
                    <div class="text-right">
                        <span class="text-muted" style="font-size: 0.8rem;">Date</span>
                        <p style="margin-bottom: 0;">@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</p>
                    </div>
                </div>

                <div class="grid grid-2" style="gap: 1rem; margin-bottom: 1.5rem;">
                    <div>
                        <span class="text-muted" style="font-size: 0.8rem;">Status</span>
                        <br>
                        <span class="badge badge-primary">@Model.Status</span>
                    </div>
                    <div class="text-right">
                        <span class="text-muted" style="font-size: 0.8rem;">Payment</span>
                        <p style="margin-bottom: 0;">@Model.PaymentMethod</p>
                    </div>
                </div>

                <hr style="border-color: var(--border-subtle);">

                <div class="mb-3">
                    <span class="text-muted" style="font-size: 0.8rem; display: block; margin-bottom: 0.5rem;">Shipping Address</span>
                    <p style="margin-bottom: 0; color: var(--text-secondary);">
                        @Model.ShippingAddress<br>
                        @Model.City, @Model.Country<br>
                        Phone: @Model.PhoneNumber
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <span class="text-muted" style="font-size: 0.8rem; display: block; margin-bottom: 0.5rem;">Notes</span>
                        <p style="margin-bottom: 0;">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>

        <!-- Order Items -->
        @if (orderItems != null && orderItems.Any())
        {
            <div class="card mb-4">
                <div class="card-body" style="padding: 0;">
                    <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-subtle);">
                        <h5 style="margin-bottom: 0;">Order Items</h5>
                    </div>
                    <div class="table-wrapper" style="border: none;">
                        <table class="table" style="font-size: 0.9rem;">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-right">Price</th>
                                    <th class="text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in orderItems)
                                {
                                    <tr>
                                        <td>Product #@item.ProductId</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-right">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-right" style="font-weight: 600;">@item.TotalPrice.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-right" style="font-weight: 600;">Total:</td>
                                    <td class="text-right">
                                        <span class="product-price" style="font-size: 1.1rem;">@Model.TotalAmount.ToString("C")</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Payment Info -->
        @if (payment != null)
        {
            <div class="card mb-4">
                <div class="card-body" style="padding: 1.25rem;">
                    <div class="flex justify-between items-center">
                        <div>
                            <span class="text-muted" style="font-size: 0.8rem;">Transaction ID</span>
                            <p style="margin-bottom: 0; font-family: monospace; font-size: 0.85rem;">@payment.TransactionId</p>
                        </div>
                        <span class="badge @(payment.Status == ECommerceProject.Models.Enums.PaymentStatus.Completed ? "badge-success" : "badge-primary")">
                            @payment.Status
                        </span>
                    </div>
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="flex justify-center gap-md">
            <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-primary">
                <i class="bi bi-list-ul"></i>
                My Orders
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">
                <i class="bi bi-house"></i>
                Home
            </a>
        </div>
    </div>
</div>