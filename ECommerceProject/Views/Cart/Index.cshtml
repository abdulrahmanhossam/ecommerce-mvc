@{
    ViewData["Title"] = "Shopping Cart";
    var cartItems = ViewBag.CartItems as List<(ECommerceProject.Models.Entities.ShoppingCart Cart, ECommerceProject.Models.Entities.Product Product)>;
    var total = ViewBag.Total as decimal? ?? 0;
}

<div class="py-4">
    <h2 style="margin-bottom: 1.5rem;">Shopping Cart</h2>

    @if (cartItems != null && cartItems.Any())
    {
        <div class="grid" style="grid-template-columns: 1fr 360px; gap: 2rem; align-items: start;">
            <!-- Cart Items -->
            <div>
                @foreach (var item in cartItems)
                {
                    <div class="cart-item">
                        <div class="cart-item-image">
                            <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "https://placehold.co/100x100?text=No+Image" : item.Product.ImageUrl)" 
                                 alt="@item.Product.Name" loading="lazy"
                                 onerror="this.src='https://placehold.co/100x100?text=No+Image'">
                        </div>
                        
                        <div class="cart-item-details">
                            <h5 class="cart-item-title">@item.Product.Name</h5>
                            <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 0;">
                                @item.Product.Price.ToString("C") each
                            </p>
                        </div>

                        <div class="quantity-input">
                            <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                <input type="hidden" name="cartId" value="@item.Cart.Id" />
                                <input type="hidden" name="quantity" value="@(item.Cart.Quantity - 1)" />
                                <button type="submit" class="quantity-btn" @(item.Cart.Quantity <= 1 ? "disabled" : "")>
                                    <i class="bi bi-dash"></i>
                                </button>
                            </form>
                            
                            <span class="quantity-value">@item.Cart.Quantity</span>
                            
                            <form asp-action="UpdateQuantity" method="post" class="d-inline">
                                <input type="hidden" name="cartId" value="@item.Cart.Id" />
                                <input type="hidden" name="quantity" value="@(item.Cart.Quantity + 1)" />
                                <button type="submit" class="quantity-btn" @(item.Cart.Quantity >= item.Product.Stock ? "disabled" : "")>
                                    <i class="bi bi-plus"></i>
                                </button>
                            </form>
                        </div>

                        <div style="min-width: 100px; text-align: right;">
                            <span class="product-price">@((item.Product.Price * item.Cart.Quantity).ToString("C"))</span>
                        </div>

                        <form asp-action="RemoveItem" method="post">
                            <input type="hidden" name="cartId" value="@item.Cart.Id" />
                            <button type="submit" class="icon-btn" onclick="return confirm('Remove this item?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }

                <div class="flex justify-between items-center mt-4">
                    <a asp-action="Index" asp-controller="Products" class="btn btn-ghost">
                        <i class="bi bi-arrow-left"></i>
                        Continue Shopping
                    </a>
                    <form asp-action="ClearCart" method="post">
                        <button type="submit" class="btn btn-ghost text-danger" onclick="return confirm('Clear entire cart?')">
                            <i class="bi bi-trash"></i>
                            Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <!-- Order Summary -->
            <div>
                <div class="cart-summary">
                    <h4>Order Summary</h4>
                    
                    <div class="cart-summary-row">
                        <span>Subtotal</span>
                        <span>@total.ToString("C")</span>
                    </div>
                    <div class="cart-summary-row">
                        <span>Shipping</span>
                        <span class="text-success">Free</span>
                    </div>
                    <div class="cart-summary-row">
                        <span>Tax (14%)</span>
                        <span>@((total * 0.14m).ToString("C"))</span>
                    </div>
                    <div class="cart-summary-row total">
                        <span>Total</span>
                        <span>@((total * 1.14m).ToString("C"))</span>
                    </div>

                    <div class="flex flex-col gap-sm mt-4">
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-credit-card"></i>
                            Checkout
                        </a>
                        <a asp-action="Index" asp-controller="Products" class="btn btn-ghost w-100">
                            Continue Shopping
                        </a>
                    </div>
                </div>

                <!-- Promo Code -->
                <div class="card mt-3">
                    <div class="card-body">
                        <p style="font-size: 0.9rem; font-weight: 500; margin-bottom: 0.75rem;">Have a promo code?</p>
                        <div class="flex gap-sm">
                            <input type="text" class="form-control" placeholder="Enter code">
                            <button class="btn btn-secondary">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-cart-x"></i>
            <h4>Your cart is empty</h4>
            <p>Add some products to get started</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag"></i>
                Start Shopping
            </a>
        </div>
    }
</div>