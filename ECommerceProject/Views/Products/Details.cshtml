@model ECommerceProject.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name;
    var variants        = ViewBag.ProductVariants as List<ECommerceProject.Models.Entities.ProductVariant>;
    var relatedProducts = ViewBag.RelatedProducts as List<ECommerceProject.Models.Entities.Product>;
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- ==================== Product Detail ==================== -->
    <div class="detail-grid">
        <!-- Product Image -->
        <div class="detail-image-wrap">
            <div class="detail-image">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/800x800?text=No+Image" : Model.ImageUrl)"
                     alt="@Model.Name"
                     loading="lazy"
                     onerror="this.src='https://placehold.co/800x800?text=No+Image'">
            </div>
        </div>

        <!-- Product Info -->
        <div>
            <!-- Badges -->
            <div class="flex items-center gap-sm mb-3">
                @if (Model.IsFeatured)
                {
                    <span class="badge badge-danger">Featured</span>
                }
                @if (Model.Category != null)
                {
                    <a asp-action="ByCategory" asp-route-id="@Model.CategoryId" class="badge badge-primary">
                        @Model.Category.Name
                    </a>
                }
            </div>

            <h1 class="mb-3">@Model.Name</h1>

            <div class="mb-4">
                <span class="detail-price">@Model.Price.ToString("C")</span>
            </div>

            <p class="text-secondary mb-4">@Model.Description</p>

            <!-- Availability -->
            <div class="flex items-center gap-md mb-4">
                <span class="text-muted">Availability:</span>
                @if (Model.Stock > 0)
                {
                    <span class="badge badge-success">In Stock (@Model.Stock available)</span>
                }
                else
                {
                    <span class="badge badge-danger">Out of Stock</span>
                }
            </div>

            <!-- Product Variants -->
            @if (variants != null && variants.Any())
            {
                <div class="mb-4">
                    <h5 class="mb-3">Available Options</h5>
                    <div class="grid grid-2" id="variantsGrid">
                        @foreach (var variant in variants)
                        {
                            var isOutOfStock = variant.Stock <= 0;
                            <label class="variant-option @(isOutOfStock ? "disabled" : "")"
                                   onclick="selectVariant(this, @variant.Id, @variant.AdditionalPrice.ToString("0.00"))">
                                <input type="radio" name="variant" value="@variant.Id"
                                       class="d-none" @(isOutOfStock ? "disabled" : "")>
                                <div class="variant-content">
                                    <div class="variant-info">
                                        @if (!string.IsNullOrEmpty(variant.Size) && !string.IsNullOrEmpty(variant.Color))
                                        {
                                            <strong>@variant.Size / @variant.Color</strong>
                                        }
                                        else if (!string.IsNullOrEmpty(variant.Size))
                                        {
                                            <strong>Size: @variant.Size</strong>
                                        }
                                        else if (!string.IsNullOrEmpty(variant.Color))
                                        {
                                            <strong>Color: @variant.Color</strong>
                                        }
                                        @if (variant.AdditionalPrice > 0)
                                        {
                                            <span class="variant-price">+@variant.AdditionalPrice.ToString("C")</span>
                                        }
                                    </div>
                                    <small class="variant-stock @(isOutOfStock ? "text-danger" : "text-muted")">
                                        @(isOutOfStock ? "Out of Stock" : $"{variant.Stock} left")
                                    </small>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- Add to Cart -->
            @if (User.Identity?.IsAuthenticated == true && Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post" id="addToCartForm">
                    <input type="hidden" name="productId"  value="@Model.Id" />
                    <input type="hidden" name="variantId"  id="selectedVariantId" value="" />

                    <div class="form-group quantity-field mb-4">
                        <label class="form-label" for="quantityInput">Quantity</label>
                        <input type="number"
                               id="quantityInput"
                               name="quantity"
                               class="form-control"
                               value="1"
                               min="1"
                               max="@Model.Stock"
                               required>
                    </div>

                    <div class="flex gap-sm mb-4">
                        <button type="submit" class="btn btn-primary btn-lg flex-fill" id="addToCartBtn">
                            <i class="bi bi-cart-plus" aria-hidden="true"></i>
                            Add to Cart
                        </button>
                        <button type="button"
                                class="icon-btn"
                                onclick="toggleWishlist(@Model.Id, this)"
                                id="wishlistBtn"
                                title="Add to wishlist"
                                aria-label="Toggle wishlist"
                                style="width:48px;height:48px;font-size:1.1rem;">
                            <i class="bi bi-heart" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    Please <a asp-controller="Account" asp-action="Login">sign in</a> to add products to your cart.
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                    This product is currently out of stock.
                </div>
            }

            <!-- AI Assistant -->
            <button type="button"
                    class="ai-assistant-btn"
                    data-product-name="@Model.Name"
                    data-product-description="@Model.Description"
                    onclick="openAIModal(this.dataset.productName, this.dataset.productDescription)">
                <i class="bi bi-sparkles" aria-hidden="true"></i>
                Ask AI Assistant
            </button>
        </div>
    </div>

    <!-- ==================== Reviews ==================== -->
    <section class="section">
        <div class="card">
            <div class="card-body" style="padding: var(--space-xl);">
                <h3 class="mb-4">
                    <i class="bi bi-star-fill text-accent" aria-hidden="true"></i>
                    Customer Reviews
                </h3>

                @if (ViewBag.TotalReviews > 0)
                {
                    <div class="review-summary-grid">
                        <div class="review-score-card">
                            <div class="review-score">@ViewBag.AverageRating.ToString("F1")</div>
                            <div class="rating justify-center mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i <= Math.Round((double)ViewBag.AverageRating) ? "" : "empty")" aria-hidden="true"></i>
                                }
                            </div>
                            <p class="text-muted mb-0">Based on @ViewBag.TotalReviews @(ViewBag.TotalReviews == 1 ? "review" : "reviews")</p>
                        </div>

                        <div>
                            @for (int stars = 5; stars >= 1; stars--)
                            {
                                var count = stars switch
                                {
                                    5 => ViewBag.FiveStars,
                                    4 => ViewBag.FourStars,
                                    3 => ViewBag.ThreeStars,
                                    2 => ViewBag.TwoStars,
                                    _ => ViewBag.OneStar
                                };
                                var percent = ViewBag.TotalReviews > 0 ? (double)count / ViewBag.TotalReviews * 100 : 0;
                                <div class="review-bar-row">
                                    <span class="review-bar-label">@stars <i class="bi bi-star-fill" aria-hidden="true"></i></span>
                                    <div class="review-bar-track" role="progressbar" aria-valuenow="@((int)percent)" aria-valuemin="0" aria-valuemax="100">
                                        <div class="review-bar-fill" style="width: @percent.ToString("F1")%;"></div>
                                    </div>
                                    <span class="review-bar-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                    <hr class="review-divider">
                }

                <!-- Write a Review -->
                                        @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (ViewBag.HasReviewed as bool? != true)
                    {
                        <div class="mb-4">
                            <h5 class="mb-3">Write a Review</h5>
                            <form asp-controller="Products" asp-action="AddReview" method="post">
                                <input type="hidden" name="ProductId" value="@Model.Id" />

                                <div class="form-group">
                                    <label class="form-label">Rating</label>
                                    <div class="rating-input" role="group" aria-label="Rating">
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            <input type="radio" name="Rating" value="@i" id="star@(i)" required>
                                            <label for="star@(i)" class="rating-star" aria-label="@i star@(i > 1 ? "s" : "")">
                                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                                            </label>
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="reviewTitle">Title (Optional)</label>
                                    <input type="text" id="reviewTitle" name="Title" class="form-control" maxlength="100" placeholder="Summarize your experience">
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="reviewComment">Your Review</label>
                                    <textarea id="reviewComment" name="Comment" class="form-control" rows="4"
                                              required minlength="10" maxlength="2000"
                                              placeholder="Share your thoughts about this product"></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send" aria-hidden="true"></i>
                                    Submit Review
                                </button>
                            </form>
                        </div>
                        <hr class="review-divider">
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            You have already reviewed this product.
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        Please <a asp-controller="Account" asp-action="Login">sign in</a> to write a review.
                    </div>
                }

                <!-- Reviews List -->
                @if (ViewBag.Reviews != null)
                {
                    var reviews = ViewBag.Reviews as List<ECommerceProject.Models.Entities.ProductReview>;

                    @if (reviews != null && reviews.Any())
                    {
                        <h5 class="mb-3">Customer Reviews (@reviews.Count)</h5>

                        @foreach (var review in reviews)
                        {
                            <div class="card review-card">
                                <div class="card-body">
                                    <div class="review-header">
                                        <div>
                                            <div class="rating mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi bi-star-fill @(i <= review.Rating ? "" : "empty")" aria-hidden="true"></i>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(review.Title))
                                            {
                                                <h6 class="mb-1">@review.Title</h6>
                                            }
                                        </div>
                                        <span class="review-date">@review.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </div>

                                    <p class="review-text">@review.Comment</p>

                                    <div class="review-actions">
                                        <span>
                                            <strong>@review.User?.FullName</strong>
                                            @if (review.IsVerifiedPurchase)
                                            {
                                                <span class="badge badge-success review-verified">&#10003; Verified</span>
                                            }
                                        </span>

                @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <button class="btn btn-ghost btn-sm" onclick="markHelpful(@review.Id, true)" aria-label="Mark as helpful">
                                                <i class="bi bi-hand-thumbs-up" aria-hidden="true"></i>
                                                <span id="helpful-@review.Id">@review.HelpfulCount</span>
                                            </button>
                                            <button class="btn btn-ghost btn-sm" onclick="markHelpful(@review.Id, false)" aria-label="Mark as not helpful">
                                                <i class="bi bi-hand-thumbs-down" aria-hidden="true"></i>
                                                <span id="nothelpful-@review.Id">@review.NotHelpfulCount</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state" style="padding: var(--space-xl) 0;">
                            <div class="empty-state-icon">
                                <i class="bi bi-chat-square-text" aria-hidden="true"></i>
                            </div>
                            <h4>No reviews yet</h4>
                            <p>Be the first to share your experience with this product</p>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    <!-- ==================== Related Products ==================== -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <section class="section">
            <div class="section-header">
                <h3>Related Products</h3>
            </div>
            <div class="grid grid-4">
                @foreach (var relatedProduct in relatedProducts)
                {
                    <article class="product-card">
                        <div class="image-wrapper">
                            <a asp-action="Details" asp-route-id="@relatedProduct.Id">
                                <img src="@(string.IsNullOrEmpty(relatedProduct.ImageUrl) ? "https://placehold.co/400x300?text=No+Image" : relatedProduct.ImageUrl)"
                                     alt="@relatedProduct.Name"
                                     loading="lazy"
                                     onerror="this.src='https://placehold.co/400x300?text=No+Image'">
                            </a>
                        </div>
                        <div class="card-content">
                            <h3 class="product-title">
                                <a asp-action="Details" asp-route-id="@relatedProduct.Id" class="product-title-link">
                                    @relatedProduct.Name
                                </a>
                            </h3>
                            <div class="price-stock-row">
                                <span class="product-price">@relatedProduct.Price.ToString("C")</span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-action="Details" asp-route-id="@relatedProduct.Id" class="btn btn-secondary btn-sm w-100">
                                <i class="bi bi-eye" aria-hidden="true"></i> View
                            </a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <input type="hidden" id="product-id" value="@Model.Id" />
    <script>
    function selectVariant(el, variantId, additionalPrice) {
        document.querySelectorAll('.variant-option').forEach(opt => opt.classList.remove('active'));
        el.classList.add('active');
        el.querySelector('input[type="radio"]').checked = true;
        document.getElementById('selectedVariantId').value = variantId;

        const basePrice = @Model.Price.ToString("0.00");
        const total = basePrice + parseFloat(additionalPrice);
        const priceEl = document.querySelector('.detail-price');
        if (priceEl) {
            priceEl.textContent = '$' + total.toFixed(2);
        }
    }
    </script>
}
