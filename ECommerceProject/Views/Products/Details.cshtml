@model ECommerceProject.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name;
    var variants = ViewBag.ProductVariants as List<ECommerceProject.Models.Entities.ProductVariant>;
    var relatedProducts = ViewBag.RelatedProducts as List<ECommerceProject.Models.Entities.Product>;
}

<div class="py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 3rem;">
        <!-- Product Image -->
        <div>
            <div class="card" style="overflow: hidden;">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.jpg" : Model.ImageUrl)" 
                     alt="@Model.Name" style="width: 100%; aspect-ratio: 1; object-fit: cover;" loading="lazy">
            </div>
        </div>

        <!-- Product Info -->
        <div>
            <div class="flex items-center gap-sm mb-3">
                @if (Model.IsFeatured)
                {
                    <span class="badge badge-danger">Featured</span>
                }
                @if (Model.Category != null)
                {
                    <a asp-action="ByCategory" asp-route-id="@Model.CategoryId" class="badge badge-primary">
                        @Model.Category.Name
                    </a>
                }
            </div>

            <h2 style="margin-bottom: 1rem;">@Model.Name</h2>
            
            <div class="flex items-center gap-sm mb-4">
                <span class="product-price" style="font-size: 1.75rem;">@Model.Price.ToString("C")</span>
            </div>

            <p class="text-muted mb-4">@Model.Description</p>

            <div class="flex items-center gap-md mb-4">
                <span class="text-secondary">Availability:</span>
                @if (Model.Stock > 0)
                {
                    <span class="badge badge-success">In Stock (@Model.Stock available)</span>
                }
                else
                {
                    <span class="badge badge-danger">Out of Stock</span>
                }
            </div>

            <!-- Product Variants -->
            @if (variants != null && variants.Any())
            {
                <div class="mb-4">
                    <h5 style="margin-bottom: 1rem;">Available Options</h5>
                    <div class="grid grid-2" style="gap: 0.75rem;">
                        @foreach (var variant in variants)
                        {
                            var isOutOfStock = variant.Stock <= 0;
                            <label class="variant-option @(isOutOfStock ? "disabled" : "")" 
                                   onclick="selectVariant(this, @variant.Id, @variant.AdditionalPrice.ToString("0.00"))">
                                <input type="radio" name="variant" value="@variant.Id" 
                                       class="d-none" @(isOutOfStock ? "disabled" : "")>
                                <div class="variant-content">
                                    <div class="variant-info">
                                        @if (!string.IsNullOrEmpty(variant.Size) && !string.IsNullOrEmpty(variant.Color))
                                        {
                                            <strong>@variant.Size / @variant.Color</strong>
                                        }
                                        else if (!string.IsNullOrEmpty(variant.Size))
                                        {
                                            <strong>Size: @variant.Size</strong>
                                        }
                                        else if (!string.IsNullOrEmpty(variant.Color))
                                        {
                                            <strong>Color: @variant.Color</strong>
                                        }
                                        @if (variant.AdditionalPrice > 0)
                                        {
                                            <span class="variant-price">+@variant.AdditionalPrice.ToString("C")</span>
                                        }
                                    </div>
                                    <small class="variant-stock @(isOutOfStock ? "text-danger" : "text-muted")">
                                        @(isOutOfStock ? "Out of Stock" : $"{variant.Stock} left")
                                    </small>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }

            <!-- Add to Cart Form -->
            @if (User.Identity?.IsAuthenticated == true && Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post" id="addToCartForm">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="variantId" id="selectedVariantId" value="" />
                    
                    <div class="form-group" style="max-width: 200px; margin-bottom: 1rem;">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="quantity" class="form-control" 
                               value="1" min="1" max="@Model.Stock" required>
                    </div>
                    
                    <div class="flex gap-sm">
                        <button type="submit" class="btn btn-primary btn-lg flex-fill" id="addToCartBtn">
                            <i class="bi bi-cart-plus"></i>
                            Add to Cart
                        </button>
                        <button type="button" class="icon-btn btn-lg" 
                                onclick="toggleWishlist(@Model.Id, this)" id="wishlistBtn">
                            <i class="bi bi-heart"></i>
                        </button>
                    </div>
                </form>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Please <a asp-controller="Account" asp-action="Login">login</a> to add products to cart.
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="bi bi-x-circle"></i>
                    This product is currently out of stock.
                </div>
            }

            <!-- AI Product Assistant Button -->
            <div class="mt-4">
                <button type="button" class="ai-assistant-btn" onclick="openAIModal('@Html.Raw(Model.Name.Replace("'", "\\'"))', '@Html.Raw(Model.Description?.Replace("'", "\\'").Replace("\n", " ").Replace("\r", ""))')">
                    <i class="bi bi-sparkles"></i>
                    Ask AI Assistant
                </button>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <section class="section">
        <div class="card">
            <div class="card-body" style="padding: 2rem;">
                <h3 style="margin-bottom: 1.5rem;">
                    <i class="bi bi-star-fill" style="color: var(--accent);"></i>
                    Customer Reviews
                </h3>
                
                @if (ViewBag.TotalReviews > 0)
                {
                    <div class="grid" style="grid-template-columns: 300px 1fr; gap: 2rem; margin-bottom: 2rem;">
                        <div class="text-center" style="padding: 2rem; background: var(--bg-tertiary); border-radius: var(--radius-lg);">
                            <h1 style="font-size: 3rem; font-weight: 700; color: var(--accent); margin-bottom: 0.5rem;">
                                @ViewBag.AverageRating.ToString("F1")
                            </h1>
                            <div class="rating justify-center mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i <= Math.Round((double)ViewBag.AverageRating) ? "" : "empty")"></i>
                                }
                            </div>
                            <p class="text-muted">Based on @ViewBag.TotalReviews reviews</p>
                        </div>

                        <div>
                            @for (int stars = 5; stars >= 1; stars--)
                            {
                                var count = stars switch {
                                    5 => ViewBag.FiveStars,
                                    4 => ViewBag.FourStars,
                                    3 => ViewBag.ThreeStars,
                                    2 => ViewBag.TwoStars,
                                    _ => ViewBag.OneStar
                                };
                                var percent = ViewBag.TotalReviews > 0 ? (double)count / ViewBag.TotalReviews * 100 : 0;
                                <div class="flex items-center gap-sm mb-2">
                                    <span style="min-width: 40px;">@stars <i class="bi bi-star-fill"></i></span>
                                    <div style="flex: 1; height: 8px; background: var(--bg-tertiary); border-radius: 4px; overflow: hidden;">
                                        <div style="width: @percent%; height: 100%; background: var(--accent); border-radius: 4px; transition: width 0.3s;"></div>
                                    </div>
                                    <span class="text-muted" style="min-width: 30px;">@count</span>
                                </div>
                            }
                        </div>
                    </div>

                    <hr style="border-color: var(--border-subtle); margin: 2rem 0;">
                }

                <!-- Add Review Form -->
                @if (User.Identity!.IsAuthenticated)
                {
                    @if (!ViewBag.HasReviewed)
                    {
                        <div class="mb-4">
                            <h5 style="margin-bottom: 1rem;">Write a Review</h5>
                            <form asp-controller="Products" asp-action="AddReview" method="post">
                                <input type="hidden" name="ProductId" value="@Model.Id" />
                                
                                <div class="form-group">
                                    <label class="form-label">Rating</label>
                                    <div class="rating" style="font-size: 1.5rem;">
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            <input type="radio" name="Rating" value="@i" id="star@(i)" required style="display: none;">
                                            <label for="star@(i)" style="cursor: pointer; color: var(--accent);">★</label>
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Title (Optional)</label>
                                    <input type="text" name="Title" class="form-control" maxlength="100">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Your Review</label>
                                    <textarea name="Comment" class="form-control" rows="4" required minlength="10" maxlength="2000"
                                              placeholder="Share your thoughts"></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send"></i>
                                    Submit Review
                                </button>
                            </form>
                        </div>
                        <hr style="border-color: var(--border-subtle); margin: 2rem 0;">
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-info-circle"></i>
                            You have already reviewed this product.
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle"></i>
                        Please <a asp-controller="Account" asp-action="Login">login</a> to write a review.
                    </div>
                }

                <!-- Reviews List -->
                @if (ViewBag.Reviews != null)
                {
                    var reviews = ViewBag.Reviews as List<ECommerceProject.Models.Entities.ProductReview>;
                    
                    @if (reviews != null && reviews.Any())
                    {
                        <h5 style="margin-bottom: 1rem;">Customer Reviews (@reviews.Count)</h5>
                        
                        @foreach (var review in reviews)
                        {
                            <div class="card" style="margin-bottom: 1rem;">
                                <div class="card-body">
                                    <div class="flex justify-between items-start mb-2">
                                        <div>
                                            <div class="rating mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi bi-star-fill @(i <= review.Rating ? "" : "empty")"></i>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(review.Title))
                                            {
                                                <h6 style="margin-bottom: 0.25rem;">@review.Title</h6>
                                            }
                                        </div>
                                        <span class="text-muted" style="font-size: 0.85rem;">@review.CreatedDate.ToString("dd MMM yyyy")</span>
                                    </div>

                                    <p class="mb-2" style="color: var(--text-secondary);">@review.Comment</p>

                                    <div class="flex items-center gap-md" style="font-size: 0.85rem; color: var(--text-muted);">
                                        <span>
                                            <strong>@review.User?.FullName</strong>
                                            @if (review.IsVerifiedPurchase)
                                            {
                                                <span class="badge badge-success" style="margin-left: 0.5rem;">✓ Verified</span>
                                            }
                                        </span>

                                        @if (User.Identity!.IsAuthenticated)
                                        {
                                            <button class="btn btn-ghost btn-sm" onclick="markHelpful(@review.Id, true)">
                                                <i class="bi bi-hand-thumbs-up"></i>
                                                <span id="helpful-@review.Id">@review.HelpfulCount</span>
                                            </button>
                                            <button class="btn btn-ghost btn-sm" onclick="markHelpful(@review.Id, false)">
                                                <i class="bi bi-hand-thumbs-down"></i>
                                                <span id="nothelpful-@review.Id">@review.NotHelpfulCount</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </section>

    <!-- Related Products -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <section class="section">
            <div class="section-header">
                <h3>Related Products</h3>
            </div>
            <div class="grid grid-4">
                @foreach (var relatedProduct in relatedProducts)
                {
                    <div class="product-card">
                        <div class="image-wrapper">
                            <img src="@(string.IsNullOrEmpty(relatedProduct.ImageUrl) ? "https://placehold.co/400x300?text=No+Image" : relatedProduct.ImageUrl)" 
                                 alt="@relatedProduct.Name" loading="lazy"
                                 onerror="this.src='https://placehold.co/400x300?text=No+Image'">
                        </div>
                        <div class="card-content">
                            <h5 class="product-title">@relatedProduct.Name</h5>
                            <span class="product-price">@relatedProduct.Price.ToString("C")</span>
                        </div>
                        <div class="card-actions">
                            <a asp-action="Details" asp-route-id="@relatedProduct.Id" class="btn btn-secondary btn-sm w-100">
                                <i class="bi bi-eye"></i>
                                View
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}

@section Scripts {
    <input type="hidden" id="product-id" value="@Model.Id" />
    <script>
    function selectVariant(el, variantId, additionalPrice) {
        document.querySelectorAll('.variant-option').forEach(opt => opt.classList.remove('active'));
        el.classList.add('active');
        el.querySelector('input[type="radio"]').checked = true;
        document.getElementById('selectedVariantId').value = variantId;

        var basePrice = @Model.Price.ToString("0.00");
        var total = basePrice + parseFloat(additionalPrice);
        var priceEl = document.querySelector('.product-price');
        if (priceEl) {
            priceEl.innerHTML = '$' + total.toFixed(2);
        }
    }
    </script>
}