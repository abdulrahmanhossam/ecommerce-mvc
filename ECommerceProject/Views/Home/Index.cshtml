@{
    ViewData["Title"] = "Home";
    var featuredProducts = ViewBag.FeaturedProducts as List<ECommerceProject.Models.Entities.Product>;
    var categories = ViewBag.Categories as List<ECommerceProject.Models.Entities.Category>;
}

<!-- ==================== Hero Section ==================== -->
<section class="hero">
    <div class="hero-background" aria-hidden="true"></div>
    <div class="container">
        <div class="grid" style="grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: center;">
            <div class="hero-content animate-fade-in-up">
                <span class="hero-badge">
                    <i class="bi bi-stars" aria-hidden="true"></i>
                    Premium Quality
                </span>
                <h1>Discover<br />Exceptional Products</h1>
                <p>Curated collections of premium items for the discerning buyer. Experience luxury shopping redefined.</p>
                <div class="hero-buttons">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-bag" aria-hidden="true"></i> Shop Now
                    </a>
                    <a href="#categories" class="btn btn-secondary btn-lg">
                        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Explore
                    </a>
                </div>
            </div>
            <div class="d-none d-lg-block animate-fade-in-up stagger-2">
                <div class="hero-visual" aria-hidden="true">
                    <i class="bi bi-bag-check"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== Features ==================== -->
<section class="section">
    <div class="container">
        <div class="grid grid-3">
            <div class="feature-card animate-fade-in-up stagger-1">
                <i class="bi bi-truck" aria-hidden="true"></i>
                <h5>Free Shipping</h5>
                <p>On orders over $50</p>
            </div>
            <div class="feature-card animate-fade-in-up stagger-2">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <h5>Secure Payment</h5>
                <p>100% secure checkout</p>
            </div>
            <div class="feature-card animate-fade-in-up stagger-3">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <h5>Easy Returns</h5>
                <p>30-day return policy</p>
            </div>
        </div>
    </div>
</section>

<!-- ==================== Categories ==================== -->
@if (categories?.Any() == true)
{
    <section class="section" id="categories">
        <div class="container">
            <header class="section-header animate-fade-in-up">
                <h2>Shop by Category</h2>
                <p>Browse our curated categories</p>
            </header>
            <div class="grid grid-3" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
                @for (int i = 0; i < Math.Min(categories.Count, 6); i++)
                {
                    <a asp-controller="Products" asp-action="ByCategory" asp-route-id="@categories[i].Id" 
                       class="category-card animate-fade-in-up"
                       style="animation-delay: @(100 + i * 50)ms"
                       aria-label="Browse @categories[i].Name products">
                        <i class="bi bi-tag-fill" aria-hidden="true"></i>
                        <span>@categories[i].Name</span>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- ==================== Featured Products ==================== -->
@if (featuredProducts?.Any() == true)
{
    <section class="section">
        <div class="container">
            <header class="section-header animate-fade-in-up">
                <h2>Featured Products</h2>
                <p>Handpicked selections for you</p>
            </header>
            <div class="grid grid-4" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
                @foreach (var product in featuredProducts)
                {
                    <article class="product-card animate-fade-in-up">
                        <div class="image-wrapper">
                            @if (product.IsFeatured)
                            {
                                <span class="badge badge-danger">Featured</span>
                            }
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/400x300?text=No+Image" : product.ImageUrl)" 
                                     alt="@product.Name"
                                     loading="lazy"
                                     onerror="this.src='https://placehold.co/400x300?text=No+Image'">
                            </a>
                        </div>
                        <div class="card-content">
                            <h3 class="product-title">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" style="color: inherit; text-decoration: none;">
                                    @product.Name
                                </a>
                            </h3>
                            <p class="product-desc">
                                @(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)
                            </p>
                            <div class="flex items-center justify-between">
                                <span class="product-price">@product.Price.ToString("C")</span>
                                <span class="badge @(product.Stock > 0 ? "badge-success" : "badge-danger")">
                                    @(product.Stock > 0 ? "In Stock" : "Sold Out")
                                </span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-secondary btn-sm flex-fill">
                                <i class="bi bi-eye" aria-hidden="true"></i> View
                            </a>
                        </div>
                    </article>
                }
            </div>
            <div class="text-center mt-5 animate-fade-in-up">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline">
                    View All Products <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- ==================== Newsletter ==================== -->
<section class="section">
    <div class="container">
        <div class="card" style="background: linear-gradient(135deg, var(--accent) 0%, #a88520 100%); border: none;">
            <div style="padding: var(--space-2xl); text-align: center; color: var(--bg-primary);">
                <h3 style="color: var(--bg-primary); margin-bottom: var(--space-sm);">Stay in the Loop</h3>
                <p style="opacity: 0.7; margin-bottom: var(--space-lg);">Get exclusive offers and new arrivals</p>
                <form class="flex justify-center gap-sm" style="max-width: 400px; margin: 0 auto;" onsubmit="event.preventDefault(); showSubscribeToast();">
                    <input type="email" class="form-control" placeholder="Enter your email" required 
                           style="background: rgba(255,255,255,0.9); border: none; color: var(--bg-primary);">
                    <button type="submit" class="btn" style="background: var(--bg-primary); color: var(--accent);">
                        Subscribe
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
function showSubscribeToast() {
    const toast = document.createElement('div');
    toast.className = 'toast-notification toast-success';
    toast.textContent = 'Thank you for subscribing!';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
}
</script>
}