@{
    ViewData["Title"] = "Home";
    var featuredProducts = ViewBag.FeaturedProducts as List<ECommerceProject.Models.Entities.Product>;
    var categories = ViewBag.Categories as List<ECommerceProject.Models.Entities.Category>;
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-background"></div>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="hero-content animate-fade-in-up">
                    <span class="hero-badge">
                        <i class="bi bi-stars"></i>
                        Premium Quality
                    </span>
                    <h1>Discover<br />Exceptional Products</h1>
                    <p>Curated collections of premium items for the discerning buyer. Experience luxury shopping redefined.</p>
                    <div class="hero-buttons">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-bag"></i>
                            Shop Now
                        </a>
                        <a href="#categories" class="btn btn-secondary btn-lg">
                            <i class="bi bi-grid-3x3-gap"></i>
                            Explore
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-image animate-fade-in-up stagger-2">
                    <div class="hero-visual">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="section">
    <div class="container">
        <div class="grid grid-3">
            <div class="feature-card animate-fade-in-up stagger-1">
                <i class="bi bi-truck"></i>
                <h5>Free Shipping</h5>
                <p>On orders over $50</p>
            </div>
            <div class="feature-card animate-fade-in-up stagger-2">
                <i class="bi bi-shield-check"></i>
                <h5>Secure Payment</h5>
                <p>100% secure checkout</p>
            </div>
            <div class="feature-card animate-fade-in-up stagger-3">
                <i class="bi bi-arrow-repeat"></i>
                <h5>Easy Returns</h5>
                <p>30-day return policy</p>
            </div>
        </div>
    </div>
</section>

<!-- Categories -->
@if (categories != null && categories.Any())
{
    <section class="section" id="categories">
        <div class="container">
            <div class="section-header animate-fade-in-up">
                <h2>Shop by Category</h2>
                <p>Browse our curated categories</p>
            </div>
            <div class="grid grid-3 grid-md-4">
                @for (int i = 0; i < categories.Count && i < 6; i++)
                {
                    <a asp-controller="Products" asp-action="ByCategory" asp-route-id="@categories[i].Id" 
                       class="category-card animate-fade-in-up" style="animation-delay: @(0.1 + i * 0.05)s">
                        <i class="bi bi-tag-fill"></i>
                        <span>@categories[i].Name</span>
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Products -->
@if (featuredProducts != null && featuredProducts.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-header animate-fade-in-up">
                <h2>Featured Products</h2>
                <p>Handpicked selections for you</p>
            </div>
            <div class="grid grid-4">
                @foreach (var product in featuredProducts)
                {
                    <div class="product-card animate-fade-in-up">
                        <div class="image-wrapper">
                            <div class="badges">
                                @if (product.IsFeatured)
                                {
                                    <span class="badge badge-danger">Featured</span>
                                }
                            </div>
                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/400x300?text=No+Image" : product.ImageUrl)" 
                                 alt="@product.Name"
                                 onerror="this.src='https://placehold.co/400x300?text=No+Image'">
                        </div>
                        <div class="card-content">
                            <h5 class="product-title">@product.Name</h5>
                            <p class="product-desc">@(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</p>
                            <div class="flex items-center justify-between">
                                <span class="product-price">@product.Price.ToString("C")</span>
                                <span class="badge @(product.Stock > 0 ? "badge-success" : "badge-danger")">
                                    @(product.Stock > 0 ? "In Stock" : "Sold Out")
                                </span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-secondary btn-sm flex-fill">
                                <i class="bi bi-eye"></i>
                                View
                            </a>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-5 animate-fade-in-up">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline">
                    View All Products
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- Newsletter -->
<section class="section">
    <div class="container">
        <div class="card" style="background: linear-gradient(135deg, var(--accent) 0%, #a88520 100%); border: none; padding: 3rem;">
            <div class="text-center" style="color: var(--bg-primary);">
                <h3 style="color: var(--bg-primary); margin-bottom: 0.5rem;">Stay in the Loop</h3>
                <p style="color: rgba(10, 10, 10, 0.7); margin-bottom: 1.5rem;">Get exclusive offers and new arrivals</p>
                <div class="flex justify-center gap-sm" style="max-width: 400px; margin: 0 auto;">
                    <input type="email" class="form-control" placeholder="Enter your email" 
                           style="background: rgba(255,255,255,0.9); border: none; color: var(--bg-primary);">
                    <button class="btn btn-secondary" style="background: var(--bg-primary); color: var(--accent); border: none;">
                        Subscribe
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>