@using ECommerceProject.Models.ViewModels
@model PaginatedList<ECommerceProject.Models.Entities.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-box-seam"></i> Manage Products</h2>
            <p class="text-muted small">Showing @Model.TotalCount products</p>
        </div>
        <a asp-action="CreateProduct" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Product
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr>
                                <td>
<img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://via.placeholder.com/50" : product.ImageUrl)" 
                                             alt="@product.Name" loading="lazy" class="img-thumb-sm">
                                </td>
                                <td>
                                    <strong>@product.Name</strong>
                                    @if (product.IsFeatured)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Featured</span>
                                    }
                                </td>
                                <td>@(ViewBag.CategoryNames?[product.CategoryId] ?? $"Category {product.CategoryId}")</td>
                                <td><strong>@product.Price.ToString("C")</strong></td>
                                <td>
                                    @if (product.Stock > 10)
                                    {
                                        <span class="badge bg-success">@product.Stock</span>
                                    }
                                    else if (product.Stock > 0)
                                    {
                                        <span class="badge bg-warning">@product.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                </td>
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                        <a asp-action="EditProduct" asp-route-id="@product.Id" 
                                           class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="DeleteProduct" asp-route-id="@product.Id" 
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="d-flex justify-content-center mt-4">
                    <ul class="pagination">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("Products", new { page = Model.PageIndex - 1 })">&laquo;</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Products", new { page = i })">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" href="@Url.Action("Products", new { page = Model.PageIndex + 1 })">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>