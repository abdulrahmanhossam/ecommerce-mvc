@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="py-4">
    <!-- Header -->
    <div class="card dashboard-header mb-4">
        <div class="card-body">
            <div class="flex justify-between items-center">
                <div>
                    <h3>
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </h3>
                    <p>Welcome back! Here's your store overview.</p>
                </div>
                <span class="dashboard-date">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>
    </div>

    <!-- Stats Grid Row 1 -->
    <div class="grid grid-4 mb-4 dashboard-grid-4">
        <div class="card stat-card stat-card-indigo">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Total Orders</p>
                        <h3 class="stat-card-value">@ViewBag.TotalOrders</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>
                <a asp-action="Orders" class="stat-card-link">View all <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>

        <div class="card stat-card stat-card-green">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Revenue</p>
                        <h3 class="stat-card-value">@String.Format("{0:C}", ViewBag.TotalRevenue ?? 0)</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
                <a asp-action="Analytics" class="stat-card-link">Analytics <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>

        <div class="card stat-card stat-card-yellow stat-card-dark">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Pending</p>
                        <h3 class="stat-card-value">@ViewBag.PendingOrders</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <a asp-action="Orders" class="stat-card-link">Review <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>

        <div class="card stat-card stat-card-sky">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Completed</p>
                        <h3 class="stat-card-value">@ViewBag.CompletedOrders</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <a asp-action="Orders" class="stat-card-link">View <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Stats Grid Row 2 -->
    <div class="grid grid-4 mb-4 dashboard-grid-4">
        <div class="card stat-card stat-card-purple">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Products</p>
                        <h3 class="stat-card-value">@ViewBag.TotalProducts</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
                <a asp-action="Products" class="stat-card-link">Manage <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>

        <div class="card stat-card stat-card-green">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Categories</p>
                        <h3 class="stat-card-value">@ViewBag.TotalCategories</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>
                </div>
                <a asp-action="Categories" class="stat-card-link">View <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>

        <div class="card stat-card stat-card-rose">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Users</p>
                        <h3 class="stat-card-value">@ViewBag.TotalUsers</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <a asp-action="Users" class="stat-card-link">Manage <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>

        <div class="card stat-card stat-card-slate">
            <div class="card-body">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="stat-card-label">Low Stock</p>
                        <h3 class="stat-card-value">@ViewBag.LowStockProducts</h3>
                    </div>
                    <div class="stat-card-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
                <a asp-action="Products" class="stat-card-link">Restock <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Charts & Top Products -->
    <div class="chart-grid">
        <div class="card">
            <div class="card-body chart-card-body">
                <h5 class="chart-card-title">
                    <i class="bi bi-pie-chart chart-icon-accent"></i>
                    Orders by Status
                </h5>
                <div class="chart-wrapper">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body chart-card-body-no-pad">
                <div class="section-header">
                    <h5>
                        <i class="bi bi-trophy icon-gold"></i>
                        Top Selling
                    </h5>
                    <span class="badge badge-primary badge-sm">This Month</span>
                </div>
                @if (ViewBag.TopProducts != null)
                {
                    var topProducts = ViewBag.TopProducts as List<(int ProductId, string Name, int Quantity, decimal Sales)>;
                    if (topProducts != null && topProducts.Any())
                    {
                        <div class="table-wrapper-borderless">
                            <table class="table table-dashboard">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Product</th>
                                        <th class="text-center">Sold</th>
                                        <th class="text-end">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < topProducts.Count; i++)
                                    {
                                        var product = topProducts[i];
                                        <tr>
                                            <td class="text-muted">@(i + 1)</td>
                                            <td class="cell-truncate">@product.Name</td>
                                            <td class="text-center"><span class="badge badge-primary badge-sm">@product.Quantity</span></td>
                                            <td class="text-end cell-revenue">@product.Sales.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state-dashboard">
                            <i class="bi bi-inbox"></i>
                            <p>No sales data yet</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Orders -->
    <div class="chart-grid">
        <div class="card">
            <div class="card-body chart-card-body">
                <h5 class="chart-card-title chart-card-title-mb">
                    <i class="bi bi-lightning icon-gold"></i>
                    Quick Actions
                </h5>
                <div class="quick-actions-grid">
                    <a asp-action="CreateProduct" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle"></i> Product
                    </a>
                    <a asp-action="CreateCategory" class="btn btn-secondary btn-sm">
                        <i class="bi bi-plus-circle"></i> Category
                    </a>
                    <a asp-action="Orders" class="btn btn-quick-yellow btn-sm">
                        <i class="bi bi-cart-check"></i> Orders
                    </a>
                    <a asp-action="Users" class="btn btn-danger btn-sm">
                        <i class="bi bi-people"></i> Users
                    </a>
                    <a asp-action="PromoCodes" class="btn btn-quick-sky btn-sm">
                        <i class="bi bi-ticket-perforated"></i> Promos
                    </a>
                    <a asp-action="Analytics" class="btn btn-outline btn-sm">
                        <i class="bi bi-graph-up"></i> Analytics
                    </a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body chart-card-body-no-pad">
                <div class="section-header">
                    <h5>
                        <i class="bi bi-clock-history"></i>
                        Recent Orders
                    </h5>
                    <a asp-action="Orders" class="btn btn-ghost btn-sm">View All <i class="bi bi-arrow-right"></i></a>
                </div>
                @if (ViewBag.RecentOrders != null)
                {
                    var recentOrders = ViewBag.RecentOrders as List<ECommerceProject.Models.Entities.Order>;
                    if (recentOrders != null && recentOrders.Any())
                    {
                        <div class="table-wrapper-borderless">
                            <table class="table table-dashboard">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Date</th>
                                        <th>Customer</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in recentOrders)
                                    {
                                        <tr>
                                            <td class="cell-order-id">#@order.Id</td>
                                            <td class="cell-date">@order.OrderDate.ToString("dd MMM HH:mm")</td>
                                            <td>@(order.User?.FullName ?? "Guest")</td>
                                            <td class="cell-total">@order.TotalAmount.ToString("C")</td>
                                            <td>
                                                @{
                                                    var (statusClass, statusLabel) = order.Status switch
                                                    {
                                                        ECommerceProject.Models.Enums.OrderStatus.Pending => ("badge badge-primary", "Pending"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Paid => ("badge badge-primary", "Paid"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Processing => ("badge badge-primary", "Processing"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Shipped => ("badge badge-primary", "Shipped"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Delivered => ("badge badge-success", "Delivered"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Cancelled => ("badge badge-danger", "Cancelled"),
                                                        _ => ("badge badge-primary", order.Status.ToString())
                                                    };
                                                }
                                                <span class="@statusClass">@statusLabel</span>
                                            </td>
                                            <td>
                                                <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-ghost btn-sm">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var salesByStatus = @Html.Raw(Json.Serialize(ViewBag.SalesByStatus));

            if (salesByStatus && salesByStatus.length > 0) {
                var ctx = document.getElementById('statusChart').getContext('2d');
                var statusData = {
                    labels: salesByStatus.map(function(s) { return s.Status; }),
                    datasets: [{
                        data: salesByStatus.map(function(s) { return s.Count; }),
                        backgroundColor: [
                            '#eab308',
                            '#38bdf8',
                            '#6366f1',
                            '#64748b',
                            '#22c55e',
                            '#f43f5e'
                        ],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                };

                new Chart(ctx, {
                    type: 'doughnut',
                    data: statusData,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 12,
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    font: { size: 11 }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}