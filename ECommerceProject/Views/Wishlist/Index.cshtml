@model List<(ECommerceProject.Models.Entities.Wishlist Wishlist, ECommerceProject.Models.Entities.Product Product)>
@{
    ViewData["Title"] = "My Wishlist";
    var wishlistCount = ViewBag.WishlistCount as int? ?? 0;
}

<div class="py-4">
    <div class="flex items-center justify-between mb-4">
        <h2>
            <i class="bi bi-heart-fill" style="color: var(--danger);"></i>
            Wishlist
        </h2>
        <span class="badge badge-primary">@wishlistCount items</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-heart"></i>
            <h4>Your wishlist is empty</h4>
            <p>Start adding products you love</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag"></i>
                Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-3">
            @foreach (var item in Model)
            {
                <div class="product-card" data-product-id="@item.Product.Id">
                    <div class="image-wrapper">
<img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "https://placehold.co/400x300?text=No+Image" : item.Product.ImageUrl)" 
                             alt="@item.Product.Name" loading="lazy"
                             onerror="this.src='https://placehold.co/400x300?text=No+Image'">
                    </div>
                    <div class="card-content">
                        <h5 class="product-title">@item.Product.Name</h5>
                        <p class="product-desc">@(item.Product.Description?.Length > 60 ? item.Product.Description.Substring(0, 60) + "..." : item.Product.Description)</p>
                        <div class="flex items-center justify-between">
                            <span class="product-price">@item.Product.Price.ToString("C")</span>
                            <span class="badge @(item.Product.Stock > 0 ? "badge-success" : "badge-danger")">
                                @(item.Product.Stock > 0 ? "In Stock" : "Out")
                            </span>
                        </div>
                    </div>
                    <div class="card-actions">
                        @if (item.Product.Stock > 0)
                        {
                            <button class="btn btn-primary btn-sm flex-fill" onclick="addToCartFromWishlist(@item.Product.Id)">
                                <i class="bi bi-cart-plus"></i>
                                Add
                            </button>
                        }
                        <button class="icon-btn" onclick="removeFromWishlist(@item.Product.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function removeFromWishlist(productId) {
            if (!confirm('Remove this item?')) return;
            
            fetch('@Url.Action("Remove", "Wishlist")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ productId: productId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function addToCartFromWishlist(productId) {
            fetch('@Url.Action("Add", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Added to cart!', 'success');
                    setTimeout(() => location.reload(), 1000);
                }
            });
        }

        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = `toast-notification toast-${type}`;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }
    </script>
}