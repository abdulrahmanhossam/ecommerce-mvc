@model List<(ECommerceProject.Models.Entities.Wishlist Wishlist, ECommerceProject.Models.Entities.Product Product)>
@{
    ViewData["Title"] = "My Wishlist";
    var wishlistCount = ViewBag.WishlistCount as int? ?? 0;
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-heart-fill text-danger"></i> My Wishlist
        <span class="badge bg-danger">@wishlistCount</span>
    </h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-heart display-1 text-muted"></i>
            <h3 class="mt-3">Your wishlist is empty</h3>
            <p class="text-muted">Start adding products to your wishlist!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-shop"></i> Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.Product.ImageUrl" class="card-img-top" alt="@item.Product.Name"
                             style="height: 200px; object-fit: cover;"
                             onerror="this.src='https://placehold.co/400x300?text=No+Image'">
                        <div class="card-body">
                            <h5 class="card-title">@item.Product.Name</h5>
                            <p class="card-text text-muted">@item.Product.Description?.Substring(0, Math.Min(100, item.Product.Description?.Length ?? 0))...</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h5 text-primary mb-0">@item.Product.Price.ToString("C")</span>
                                <span class="badge @(item.Product.Stock > 0 ? "bg-success" : "bg-danger")">
                                    @(item.Product.Stock > 0 ? "In Stock" : "Out of Stock")
                                </span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex gap-2">
                                @if (item.Product.Stock > 0)
                                {
                                    <button class="btn btn-success flex-grow-1" onclick="addToCartFromWishlist(@item.Product.Id)">
                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                    </button>
                                }
                                <button class="btn btn-outline-danger" onclick="removeFromWishlist(@item.Product.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function removeFromWishlist(productId) {
            fetch('@Url.Action("Remove", "Wishlist")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify(productId)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function addToCartFromWishlist(productId) {
            fetch('@Url.Action("Add", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateCartCount();
                    removeFromWishlist(productId);
                } else {
                    alert(data.message || 'Error adding to cart');
                }
            });
        }

        function updateCartCount() {
            fetch('@Url.Action("GetCount", "Cart")')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('cartCount').textContent = data.count;
                });
        }
    </script>
}