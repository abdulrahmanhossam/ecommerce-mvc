@model ECommerceProject.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var totalOrders = ViewBag.TotalOrders as int? ?? 0;
    var totalSpent = ViewBag.TotalSpent as decimal? ?? 0;
    var pendingOrders = ViewBag.PendingOrders as int? ?? 0;
    var completedOrders = ViewBag.CompletedOrders as int? ?? 0;
    var wishlistCount = ViewBag.WishlistCount as int? ?? 0;
    var cartCount = ViewBag.CartCount as int? ?? 0;
    var recentOrders = ViewBag.RecentOrders as List<ECommerceProject.Models.Entities.Order>;
}

<style>
    .stat-card {
        border-radius: var(--radius-lg);
        transition: all 0.25s ease;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }
    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .stat-icon i { font-size: 1rem; }
    .action-btn {
        border-radius: var(--radius-md);
        padding: 0.7rem;
        transition: all 0.2s ease;
    }
    .action-btn:hover {
        transform: translateY(-2px);
    }
    .profile-card {
        border-radius: var(--radius-lg);
    }
    .sidebar-card {
        border-radius: var(--radius-md);
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-person-circle text-primary"></i> My Dashboard</h4>
            <p class="text-muted mb-0 small">Welcome back! Here's your account overview.</p>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card text-white h-100" style="background: linear-gradient(135deg, #6366f1, #818cf8);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-label text-white-50 mb-0 small">Total Orders</p>
                            <h4 class="stat-value mb-0">@totalOrders</h4>
                        </div>
                        <div class="stat-icon bg-white bg-opacity-15">
                            <i class="bi bi-bag-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-6 col-lg-3">
            <div class="card stat-card text-white h-100" style="background: linear-gradient(135deg, #22c55e, #4ade80);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-label text-white-50 mb-0 small">Completed</p>
                            <h4 class="stat-value mb-0">@completedOrders</h4>
                        </div>
                        <div class="stat-icon bg-white bg-opacity-15">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card stat-card text-white h-100" style="background: linear-gradient(135deg, #eab308, #fde047);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-label text-white opacity-75 mb-0 small">Pending</p>
                            <h4 class="stat-value mb-0">@pendingOrders</h4>
                        </div>
                        <div class="stat-icon bg-white bg-opacity-15">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card stat-card text-white h-100" style="background: linear-gradient(135deg, #a855f7, #c084fc);">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="stat-label text-white-50 mb-0 small">Total Spent</p>
                            <h4 class="stat-value mb-0">@totalSpent.ToString("C")</h4>
                        </div>
                        <div class="stat-icon bg-white bg-opacity-15">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <a asp-controller="Wishlist" asp-action="Index" class="btn action-btn btn-outline-danger w-100">
                <i class="bi bi-heart"></i> <span class="small">Wishlist</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Cart" asp-action="Index" class="btn action-btn btn-outline-warning w-100">
                <i class="bi bi-cart4"></i> <span class="small">Cart</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Orders" asp-action="MyOrders" class="btn action-btn btn-outline-success w-100">
                <i class="bi bi-box-seam"></i> <span class="small">Orders</span>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Products" asp-action="Index" class="btn action-btn btn-outline-primary w-100">
                <i class="bi bi-shop"></i> <span class="small">Shop</span>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Profile Form -->
        <div class="col-lg-8">
            <div class="card profile-card">
                <div class="card-header bg-transparent border-0 py-3">
                    <h6 class="fw-semibold mb-0"><i class="bi bi-person me-2"></i>Profile Information</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Profile" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label">Full Name</label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" readonly />
                                <small class="text-muted">Email cannot be changed</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter your address"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Country" class="form-label">Country</label>
                                <input asp-for="Country" class="form-control" placeholder="Country" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (Model.MemberSince.HasValue)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="bi bi-info-circle me-2"></i>
                                Member since @Model.MemberSince.Value.ToString("dd MMMM yyyy")
                            </div>
                        }

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Recent Orders -->
            @if (recentOrders != null && recentOrders.Any())
            {
                <div class="card mt-4 profile-card">
                    <div class="card-header bg-transparent py-3">
                        <h6 class="fw-semibold mb-0"><i class="bi bi-clock-history me-2"></i>Recent Orders</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" style="font-size: 0.85rem;">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Order #</th>
                                        <th>Date</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th class="pe-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in recentOrders)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold">#@order.Id</td>
                                            <td class="text-muted">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                            <td class="fw-semibold">@order.TotalAmount.ToString("C")</td>
                                            <td>
                                                @{
                                                    var (bgClass, label) = order.Status switch
                                                    {
                                                        ECommerceProject.Models.Enums.OrderStatus.Pending => ("bg-warning", "Pending"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Paid => ("bg-info", "Paid"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Processing => ("bg-primary", "Processing"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Shipped => ("bg-secondary", "Shipped"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Delivered => ("bg-success", "Delivered"),
                                                        ECommerceProject.Models.Enums.OrderStatus.Cancelled => ("bg-danger", "Cancelled"),
                                                        _ => ("bg-primary", order.Status.ToString())
                                                    };
                                                }
                                                <span class="badge @bgClass">@label</span>
                                            </td>
                                            <td class="pe-3">
                                                <a asp-controller="Orders" asp-action="MyOrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center py-3 border-top">
                            <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-outline-primary btn-sm">
                                View All Orders <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card sidebar-card mb-3">
                <div class="card-body">
                    <h6 class="fw-semibold mb-2"><i class="bi bi-key me-2"></i>Security</h6>
                    <p class="text-muted small mb-3">Keep your account secure.</p>
                    <a asp-action="ChangePassword" class="btn btn-warning w-100 btn-sm">
                        <i class="bi bi-key me-1"></i>Change Password
                    </a>
                </div>
            </div>

            <div class="card sidebar-card mb-3">
                <div class="card-body">
                    <h6 class="fw-semibold mb-2"><i class="bi bi-box-seam me-2"></i>My Orders</h6>
                    <p class="text-muted small mb-3">View and track your orders.</p>
                    <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-success w-100 btn-sm">
                        <i class="bi bi-box-seam me-1"></i>View Orders
                    </a>
                </div>
            </div>

            <div class="card sidebar-card border-danger">
                <div class="card-body">
                    <h6 class="fw-semibold mb-2 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Danger Zone</h6>
                    <p class="text-muted small mb-3">Permanently delete your account.</p>
                    <a asp-action="DeleteAccount" class="btn btn-outline-danger w-100 btn-sm">
                        <i class="bi bi-trash me-1"></i>Delete Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}