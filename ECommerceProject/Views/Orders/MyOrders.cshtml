@model ECommerceProject.Models.ViewModels.PaginatedList<ECommerceProject.Models.Entities.Order>
@{
    ViewData["Title"] = "My Orders";
    var pageSize = 10;
}

<div class="py-4">
    <h2 style="margin-bottom: 1.5rem;">
        <i class="bi bi-box-seam"></i>
        My Orders
    </h2>

    @if (Model != null && Model.Items.Any())
    {
        <div class="flex flex-col gap-md">
            @foreach (var order in Model.Items)
            {
                <div class="card">
                    <div class="card-body" style="padding: 1.25rem;">
                        <div class="grid" style="grid-template-columns: 1fr auto auto auto auto auto; gap: 1.5rem; align-items: center;">
                            <div>
                                <h5 style="margin-bottom: 0.25rem; font-size: 1rem;">Order #@order.Id</h5>
                                <span class="text-muted" style="font-size: 0.85rem;">@order.OrderDate.ToString("dd MMM yyyy")</span>
                            </div>

                            @{
                                var statusClass = order.Status switch
                                {
                                    ECommerceProject.Models.Enums.OrderStatus.Pending => "badge badge-primary",
                                    ECommerceProject.Models.Enums.OrderStatus.Paid => "badge badge-primary",
                                    ECommerceProject.Models.Enums.OrderStatus.Processing => "badge badge-primary",
                                    ECommerceProject.Models.Enums.OrderStatus.Shipped => "badge badge-primary",
                                    ECommerceProject.Models.Enums.OrderStatus.Delivered => "badge badge-success",
                                    ECommerceProject.Models.Enums.OrderStatus.Cancelled => "badge badge-danger",
                                    _ => "badge badge-primary"
                                };
                            }
                            <span class="@statusClass">@order.Status</span>

                            <span class="text-muted" style="font-size: 0.9rem;">
                                <span class="text-secondary" style="font-size: 0.75rem; display: block;">Payment</span>
                                @order.PaymentMethod
                            </span>

                            <span class="product-price" style="font-size: 1rem;">
                                @order.TotalAmount.ToString("C")
                            </span>

                            <span class="text-muted" style="font-size: 0.85rem;">
                                <span style="font-size: 0.75rem; display: block; color: var(--text-muted);">Ship to</span>
                                @order.City, @order.Country
                            </span>

                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-secondary btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination mt-4" aria-label="Orders pagination">
                @if (Model.HasPreviousPage)
                {
                    <a class="page-link" asp-action="MyOrders" asp-route-page="@(Model.PageIndex - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                else
                {
                    <span class="page-link disabled"><i class="bi bi-chevron-left"></i></span>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="page-link @(i == Model.PageIndex ? "active" : "")"
                       asp-action="MyOrders" asp-route-page="@i"
                       aria-label="Page @i">@i</a>
                }

                @if (Model.HasNextPage)
                {
                    <a class="page-link" asp-action="MyOrders" asp-route-page="@(Model.PageIndex + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="page-link disabled"><i class="bi bi-chevron-right"></i></span>
                }
            </nav>

            <p class="page-info text-center mt-2">
                Showing @((Model.PageIndex - 1) * pageSize + 1)-@Math.Min(Model.PageIndex * pageSize, Model.TotalCount) of @Model.TotalCount
            </p>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No orders yet</h4>
            <p>Start shopping to see your orders here</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag"></i>
                Start Shopping
            </a>
        </div>
    }
</div>
